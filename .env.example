# Create the bot with @BotFather, add it to the channel as an administrator,
# and grant it permission to post messages. Never commit the real token.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Production persistence. Apply migrations as a release step with
# `pnpm db:migrate`; AUTO_MIGRATE is convenient only for controlled deployments.
# DATABASE_URL=postgres://publisher:replace_me@postgres:5432/publisher
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10
# AUTO_MIGRATE=false

# P0 multi-tenant development bootstrap. This in-memory seed and its opaque
# bearer credentials are retained only for local development/migration.
# Keep this JSON on one line.
# SAAS_BOOTSTRAP_JSON='{"workspaces":[{"id":"ws_demo","name":"Demo"}],"users":[{"id":"user_demo","workspaceId":"ws_demo","email":"owner@example.com"}],"channels":[{"id":"ch_demo","workspaceId":"ws_demo","telegramChatId":"@demo_channel","title":"Demo channel","name":"Demo","username":"demo_channel","status":"active","botPermissions":{"canPostMessages":true},"isDefault":true}],"automationGrants":[],"credentials":[{"id":"cred_demo","token":"replace_with_at_least_24_random_characters","userId":"user_demo","workspaceId":"ws_demo"}]}'

# Canonical public MCP resource and established external OAuth 2.1 issuer.
# In PostgreSQL mode these URLs and JWKS must use HTTPS unless the explicit
# local-only OAUTH_ALLOW_INSECURE_HTTP override is enabled.
PUBLIC_BASE_URL=https://publisher.example.com
OAUTH_ISSUER=https://auth.publisher.example.com
OAUTH_JWKS_URI=https://auth.publisher.example.com/.well-known/jwks.json
# Must equal PUBLIC_BASE_URL + /mcp. It can be omitted because the server derives it.
# OAUTH_AUDIENCE=https://publisher.example.com/mcp
OAUTH_JWT_ALGORITHMS=RS256
OAUTH_CLOCK_TOLERANCE_SECONDS=5
OAUTH_REQUIRE_JTI=true
# Enable only when this is the access-token typ emitted by the selected IdP.
# OAUTH_REQUIRED_TYP=at+jwt
# Temporary migration escape hatch; never enable for a commercial deployment.
ALLOW_OPAQUE_BOOTSTRAP_AUTH=false
PREVIEW_TTL_SECONDS=900

# Telegram onboarding uses an OAuth-owned one-time challenge. The raw challenge
# is never stored; this server-side pepper protects its HMAC hash. Telegram sends
# the webhook secret in X-Telegram-Bot-Api-Secret-Token.
ONBOARDING_TOKEN_PEPPER=replace_with_at_least_32_random_characters
TELEGRAM_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
ONBOARDING_CHALLENGE_TTL_SECONDS=600

# Run `pnpm db:cleanup` on a schedule. Stale in-progress attempts are marked
# ambiguous before retention cleanup, so they are never retried automatically.
PUBLICATION_ATTEMPT_STALE_SECONDS=300
PREVIEW_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90

# Legacy single-user migration mode only. In SaaS mode channels come from the
# workspace store above, not this global allowlist.
TELEGRAM_CHANNELS_JSON='{"News":"@demo_channel","News test":"-1001234567890"}'

# Used when a tool call omits the channels field.
TELEGRAM_DEFAULT_CHANNEL=News

# Legacy single-channel alternative. Use this only when TELEGRAM_CHANNELS_JSON
# is not configured. TELEGRAM_DEFAULT_CHANNEL becomes its human-readable name.
# TELEGRAM_CHANNEL_ID=@alterego_news

# Private MCP URL protection. Use at least 24 random letters, digits, _ or -.
# Generate one with: openssl rand -hex 24
MCP_ACCESS_KEY=replace_with_a_long_random_value

# Optional.
PORT=8787
TELEGRAM_DISABLE_NOTIFICATION=false

# Legacy single-user mode only. SaaS scheduled publishing ignores this flag and
# requires an active AutomationGrant bound to the bearer credential.
ALLOW_SCHEDULED_PUBLISH=false

# Private temporary storage for locally generated publication images. Files are
# uploaded directly to Telegram, deleted after publish_digest, and otherwise
# expire after MEDIA_TTL_SECONDS. No public media URL or Caddy route is required.
MEDIA_STORAGE_DIR=/tmp/alterego-telegram-publisher-media
MEDIA_TTL_SECONDS=3600
MEDIA_MAX_BYTES=10485760

# Optional HTTP(S) CONNECT proxy used only for Telegram Bot API requests.
# A VLESS client such as sing-box can expose a local mixed/HTTP inbound here.
# When both services run in Docker Compose, use the proxy service name, not localhost.
# TELEGRAM_PROXY_URL=http://vless-proxy:1080
